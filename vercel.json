{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "backend/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/auth/login", "destination": "/auth.html" },
    { "source": "/auth/register", "destination": "/auth.html?mode=register" },
    { "source": "/login", "destination": "/auth.html" },
    { "source": "/register", "destination": "/auth.html?mode=register" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/interview", "destination": "/interview.html" },
    { "source": "/results", "destination": "/results.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" }
  ]
}
